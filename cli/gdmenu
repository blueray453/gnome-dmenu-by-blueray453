#!/usr/bin/env gjs

imports.gi.versions.Gio = '2.0';
const { Gio, GLib } = imports.gi;
const System = imports.system;

let GioUnix;
try { GioUnix = imports.gi.GioUnix; } catch (e) { GioUnix = null; }

const BUS_NAME = 'org.gnome.Shell.Extensions.SimpleDmenu';
const OBJECT_PATH = '/org/gnome/Shell/Extensions/SimpleDmenu';
const INTERFACE_NAME = 'org.gnome.Shell.Extensions.SimpleDmenu';
const INTROSPECTABLE_INTERFACE = 'org.freedesktop.DBus.Introspectable';

function showHelp() {
    print(`
Usage:
  gdmenu [OPTIONS]

Modes (choose one):
  --drun         Show applications (app launcher)
  --window       Show open windows (window switcher)
  --paths        Read file paths from stdin and show with icons
  (no mode)      Read plain text lines from stdin

Options:
  --multi        Enable multi‑select (default: off)
  --hint TEXT    Custom hint text in search entry
  --fullscreen   Make the menu fullscreen
  --help         Show this help
`);
}

// ----------------------------------------------------------------------
// Extract the specific <interface> block from the full introspection XML
// ----------------------------------------------------------------------
function extractInterfaceXml(fullXml, interfaceName) {
    const regex = new RegExp(`<interface\\s+name="${interfaceName}"[^>]*>[\\s\\S]*?</interface>`);
    const match = fullXml.match(regex);
    if (!match) {
        throw new Error(`Interface "${interfaceName}" not found in introspection XML`);
    }
    // makeProxyWrapper requires a valid <node> wrapper around the interface
    return `<node>\n${match[0]}\n</node>`;
}

// ----------------------------------------------------------------------
// Fetch XML via Introspect and create a Proxy dynamically
// ----------------------------------------------------------------------
function getProxy(busName, objectPath, interfaceName) {
    let introProxy;
    try {
        introProxy = Gio.DBusProxy.new_for_bus_sync(
            Gio.BusType.SESSION,
            Gio.DBusProxyFlags.NONE,
            null,
            busName,
            objectPath,
            INTROSPECTABLE_INTERFACE,
            null
        );
    } catch (e) {
        throw new Error(`Could not create introspection proxy: ${e.message}`);
    }

    let fullXml;
    try {
        const result = introProxy.call_sync(
            'Introspect',
            null,
            Gio.DBusCallFlags.NONE,
            -1,
            null
        );
        fullXml = result.deepUnpack()[0];
    } catch (e) {
        throw new Error(`Introspect call failed: ${e.message}`);
    }

    try {
        const ifaceXml = extractInterfaceXml(fullXml, interfaceName);
        const ProxyClass = Gio.DBusProxy.makeProxyWrapper(ifaceXml);
        return new ProxyClass(Gio.DBus.session, busName, objectPath);
    } catch (e) {
        throw new Error(`Failed to create proxy wrapper: ${e.message}`);
    }
}

function readStdinLines() {
    const unixStream = GioUnix
        ? new GioUnix.InputStream({ fd: 0, close_fd: false })
        : new Gio.UnixInputStream({ fd: 0, close_fd: false });
    const dataStream = new Gio.DataInputStream({ base_stream: unixStream });

    const lines = [];
    while (true) {
        const [line] = dataStream.read_line_utf8(null);
        if (line === null) break;
        if (line.length > 0) lines.push(line);
    }
    return lines;
}

function main() {
    let mode = null;
    let multi = false;
    let hint = '';
    let fullscreen = false;

    for (let i = 0; i < ARGV.length; i++) {
        const arg = ARGV[i];
        if (arg === '--help' || arg === '-h') {
            showHelp();
            System.exit(0);
        } else if (arg === '--drun') {
            mode = 'drun';
        } else if (arg === '--window') {
            mode = 'window';
        } else if (arg === '--paths') {
            mode = 'paths';
        } else if (arg === '--multi') {
            multi = true;
        } else if (arg === '--fullscreen') {
            fullscreen = true;
        } else if (arg === '--hint') {
            if (i + 1 < ARGV.length) {
                hint = ARGV[++i];
            } else {
                printerr('gdmenu: --hint requires an argument');
                System.exit(1);
            }
        } else {
            printerr(`Unknown option: ${arg}`);
            showHelp();
            System.exit(1);
        }
    }

    // Read input based on mode
    let lines = [];
    if (mode === null || mode === 'paths') {
        lines = readStdinLines();
        if (lines.length === 0) {
            printerr('gdmenu: no input provided');
            System.exit(1);
        }
    }

    const loop = GLib.MainLoop.new(null, false);
    let result = null;

    // Construct the proxy dynamically via introspection
    let proxy;
    try {
        proxy = getProxy(BUS_NAME, OBJECT_PATH, INTERFACE_NAME);
    } catch (e) {
        if (e instanceof Gio.DBusError)
            Gio.DBusError.strip_remote_error(e);
        printerr(`gdmenu: could not reach extension: ${e.message}`);
        printerr('gdmenu: is the simple-dmenu GNOME Shell extension enabled?');
        System.exit(2);
    }

    // connectSignal() scopes the subscription to this proxy's connection
    const selectedId = proxy.connectSignal('Selected', (_proxy, _sender, args) => {
        result = args[0];
        loop.quit();
    });
    const cancelledId = proxy.connectSignal('Cancelled', () => {
        result = null;
        loop.quit();
    });

    try {
        // No type strings anywhere — makeProxyWrapper handles packing automatically
        if (mode === 'drun') {
            proxy.ShowAppsSync(multi, hint, fullscreen);
        } else if (mode === 'window') {
            proxy.ShowWindowsSync(multi, hint, fullscreen);
        } else if (mode === 'paths') {
            proxy.ShowPathsSync(lines, multi, hint, fullscreen);
        } else {
            // stdin mode
            proxy.ShowSync(lines, multi, hint, fullscreen);
        }
    } catch (e) {
        if (e instanceof Gio.DBusError)
            Gio.DBusError.strip_remote_error(e);
        printerr(`gdmenu: D‑Bus call failed: ${e.message}`);
        System.exit(2);
    }

    loop.run();

    proxy.disconnectSignal(selectedId);
    proxy.disconnectSignal(cancelledId);

    if (result && result.length > 0) {
        for (const item of result) {
            print(item);
        }
        System.exit(0);
    } else {
        System.exit(1);
    }
}

main();