#!/usr/bin/env gjs

imports.gi.versions.Gio = '2.0';
const { Gio, GLib } = imports.gi;
const System = imports.system;

let GioUnix;
try { GioUnix = imports.gi.GioUnix; } catch (e) { GioUnix = null; }

const SPEC_CACHE_FILE = GLib.build_filenamev([
    GLib.get_home_dir(), '.cache', 'gnome-dbus-spec', 'simple-dmenu.json'
]);

function showHelp() {
    print(`
Usage:
  gdmenu [OPTIONS]

Modes (choose one):
  --drun         Show applications (app launcher)
  --window       Show open windows (window switcher)
  --paths        Read file paths from stdin and show with icons
  (no mode)      Read plain text lines from stdin

Options:
  --multi        Enable multi‑select (default: off)
  --hint TEXT    Custom hint text in search entry
  --fullscreen   Make the menu fullscreen
  --help         Show this help
`);
}

// ----------------------------------------------------------------------
// Build the proxy from the spec cache written by the extension.
// No cache  => extension is not enabled. No introspection fallback.
// ----------------------------------------------------------------------
function getProxy() {
    const file = Gio.File.new_for_path(SPEC_CACHE_FILE);
    if (!file.query_exists(null)) {
        printerr('gdmenu: simple-dmenu extension is not enabled');
        System.exit(2);
    }

    let spec;
    try {
        const [ok, contents] = file.load_contents(null);
        spec = JSON.parse(new TextDecoder().decode(contents));
    } catch (e) {
        printerr('gdmenu: failed to read cache');
        System.exit(2);
    }

    // Validate that the required fields exist
    if (!spec.xml || !spec.bus_name || !spec.object_path) {
        printerr('gdmenu: cache is malformed');
        System.exit(2);
    }

    try {
        // Build proxy entirely from cache data
        const ProxyClass = Gio.DBusProxy.makeProxyWrapper(spec.xml);
        return new ProxyClass(Gio.DBus.session, spec.bus_name, spec.object_path);
    } catch (e) {
        if (e instanceof Gio.DBusError) Gio.DBusError.strip_remote_error(e);
        printerr(`gdmenu: could not reach extension: ${e.message}`);
        System.exit(2);
    }
}

function readStdinLines() {
    const unixStream = GioUnix
        ? new GioUnix.InputStream({ fd: 0, close_fd: false })
        : new Gio.UnixInputStream({ fd: 0, close_fd: false });
    const dataStream = new Gio.DataInputStream({ base_stream: unixStream });

    const lines = [];
    while (true) {
        const [line] = dataStream.read_line_utf8(null);
        if (line === null) break;
        if (line.length > 0) lines.push(line);
    }
    return lines;
}

function main() {
    let mode = null;
    let multi = false;
    let hint = '';
    let fullscreen = false;

    for (let i = 0; i < ARGV.length; i++) {
        const arg = ARGV[i];
        if (arg === '--help' || arg === '-h') {
            showHelp();
            System.exit(0);
        } else if (arg === '--drun') {
            mode = 'drun';
        } else if (arg === '--window') {
            mode = 'window';
        } else if (arg === '--paths') {
            mode = 'paths';
        } else if (arg === '--multi') {
            multi = true;
        } else if (arg === '--fullscreen') {
            fullscreen = true;
        } else if (arg === '--hint') {
            if (i + 1 < ARGV.length) {
                hint = ARGV[++i];
            } else {
                printerr('gdmenu: --hint requires an argument');
                System.exit(1);
            }
        } else {
            printerr(`Unknown option: ${arg}`);
            showHelp();
            System.exit(1);
        }
    }

    // Read input based on mode
    let lines = [];
    if (mode === null || mode === 'paths') {
        lines = readStdinLines();
        if (lines.length === 0) {
            printerr('gdmenu: no input provided');
            System.exit(1);
        }
    }

    const loop = GLib.MainLoop.new(null, false);
    let result = null;

    // Build proxy from the spec cache
    const proxy = getProxy();

    // connectSignal() scopes the subscription to this proxy's connection
    const selectedId = proxy.connectSignal('Selected', (_proxy, _sender, args) => {
        result = args[0];
        loop.quit();
    });
    const cancelledId = proxy.connectSignal('Cancelled', () => {
        result = null;
        loop.quit();
    });

    try {
        if (mode === 'drun') {
            proxy.ShowAppsSync(multi, hint, fullscreen);
        } else if (mode === 'window') {
            proxy.ShowWindowsSync(multi, hint, fullscreen);
        } else if (mode === 'paths') {
            proxy.ShowPathsSync(lines, multi, hint, fullscreen);
        } else {
            // stdin mode
            proxy.ShowSync(lines, multi, hint, fullscreen);
        }
    } catch (e) {
        if (e instanceof Gio.DBusError)
            Gio.DBusError.strip_remote_error(e);
        printerr(`gdmenu: D‑Bus call failed: ${e.message}`);
        System.exit(2);
    }

    loop.run();

    proxy.disconnectSignal(selectedId);
    proxy.disconnectSignal(cancelledId);

    if (result && result.length > 0) {
        for (const item of result) {
            print(item);
        }
        System.exit(0);
    } else {
        System.exit(1);
    }
}

main();