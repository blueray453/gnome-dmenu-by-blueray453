#!/usr/bin/env gjs

imports.gi.versions.Gio = '2.0';
const { Gio, GLib } = imports.gi;
const System = imports.system;

let GioUnix;
try { GioUnix = imports.gi.GioUnix; } catch (e) { GioUnix = null; }

const BUS_NAME = 'org.gnome.Shell.Extensions.SimpleDmenu';
const OBJECT_PATH = '/org/gnome/Shell/Extensions/SimpleDmenu';

const DBUS_INTERFACE = `
<node>
  <interface name="org.gnome.Shell.Extensions.SimpleDmenu">
    <method name="Show">
      <arg type="as" name="items" direction="in"/>
      <arg type="b" name="multi" direction="in"/>
      <arg type="s" name="hint" direction="in"/>
      <arg type="b" name="fullscreen" direction="in"/>
    </method>
    <method name="ShowApps">
      <arg type="b" name="multi" direction="in"/>
      <arg type="s" name="hint" direction="in"/>
      <arg type="b" name="fullscreen" direction="in"/>
    </method>
    <method name="ShowWindows">
      <arg type="b" name="multi" direction="in"/>
      <arg type="s" name="hint" direction="in"/>
      <arg type="b" name="fullscreen" direction="in"/>
    </method>
    <method name="ShowPaths">
      <arg type="as" name="paths" direction="in"/>
      <arg type="b" name="multi" direction="in"/>
      <arg type="s" name="hint" direction="in"/>
      <arg type="b" name="fullscreen" direction="in"/>
    </method>
    <signal name="Selected">
      <arg type="as" name="items"/>
    </signal>
    <signal name="Cancelled"/>
  </interface>
</node>`;

// Proxy wrapper – gives us typed *Sync and *Async methods
const DmenuProxy = Gio.DBusProxy.makeProxyWrapper(DBUS_INTERFACE);

function readStdinLines() {
    const unixStream = GioUnix
        ? new GioUnix.InputStream({ fd: 0, close_fd: false })
        : new Gio.UnixInputStream({ fd: 0, close_fd: false });
    const dataStream = new Gio.DataInputStream({ base_stream: unixStream });

    const lines = [];
    while (true) {
        const [line] = dataStream.read_line_utf8(null);
        if (line === null) break;
        if (line.length > 0) lines.push(line);
    }
    return lines;
}

function showHelp() {
    print(`
Usage:
  gdmenu [OPTIONS]

Modes (choose one):
  --drun         Show applications (app launcher)
  --window       Show open windows (window switcher)
  --paths        Read file paths from stdin and show with icons
  (no mode)      Read plain text lines from stdin

Options:
  --multi        Enable multi‑select (default: off)
  --hint TEXT    Custom hint text in search entry
  --fullscreen   Make the menu fullscreen
  --help         Show this help
`);
}

async function mainAsync() {
    let mode = null;        // 'drun', 'window', 'paths', or null (stdin)
    let multi = false;
    let hint = '';
    let fullscreen = false;

    // Parse command line
    for (let i = 0; i < ARGV.length; i++) {
        const arg = ARGV[i];
        if (arg === '--help' || arg === '-h') {
            showHelp();
            System.exit(0);
        } else if (arg === '--drun') {
            mode = 'drun';
        } else if (arg === '--window') {
            mode = 'window';
        } else if (arg === '--paths') {
            mode = 'paths';
        } else if (arg === '--multi') {
            multi = true;
        } else if (arg === '--fullscreen') {
            fullscreen = true;
        } else if (arg === '--hint') {
            if (i + 1 < ARGV.length) {
                hint = ARGV[++i];
            } else {
                printerr('gdmenu: --hint requires an argument');
                System.exit(1);
            }
        } else {
            printerr(`Unknown option: ${arg}`);
            showHelp();
            System.exit(1);
        }
    }

    // Read input based on mode
    let lines = [];
    if (mode === null || mode === 'paths') {
        lines = readStdinLines();
        if (lines.length === 0) {
            printerr('gdmenu: no input provided');
            System.exit(1);
        }
    }

    // Main loop – we need it to wait for the signal
    const loop = GLib.MainLoop.new(null, false);
    let result = null;

    // Create the proxy
    let proxy;
    try {
        proxy = DmenuProxy(Gio.DBus.session, BUS_NAME, OBJECT_PATH);
    } catch (e) {
        if (e instanceof Gio.DBusError)
            Gio.DBusError.strip_remote_error(e);
        printerr(`gdmenu: could not reach extension: ${e.message}`);
        printerr('gdmenu: is the simple-dmenu GNOME Shell extension enabled?');
        System.exit(2);
    }

    // Connect signals – these will quit the loop
    const selectedId = proxy.connectSignal('Selected', (_proxy, _sender, args) => {
        result = args[0];
        loop.quit();
    });
    const cancelledId = proxy.connectSignal('Cancelled', () => {
        result = null;
        loop.quit();
    });

    // Make the D‑Bus call asynchronously
    try {
        if (mode === 'drun') {
            await proxy.ShowAppsAsync(multi, hint, fullscreen);
        } else if (mode === 'window') {
            await proxy.ShowWindowsAsync(multi, hint, fullscreen);
        } else if (mode === 'paths') {
            await proxy.ShowPathsAsync(lines, multi, hint, fullscreen);
        } else {
            // stdin mode
            await proxy.ShowAsync(lines, multi, hint, fullscreen);
        }
    } catch (e) {
        if (e instanceof Gio.DBusError)
            Gio.DBusError.strip_remote_error(e);
        printerr(`gdmenu: D‑Bus call failed: ${e.message}`);
        System.exit(2);
    }

    // Wait for the user to select or cancel
    loop.run();

    // Clean up signal handlers
    proxy.disconnectSignal(selectedId);
    proxy.disconnectSignal(cancelledId);

    // Output result and exit
    if (result && result.length > 0) {
        for (const item of result) {
            print(item);
        }
        System.exit(0);
    } else {
        System.exit(1);
    }
}

// Entry point – run the async function and catch any unhandled errors
mainAsync().catch(e => {
    printerr(`gdmenu: uncaught error: ${e.message}`);
    System.exit(2);
});